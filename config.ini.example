; ══════════════════════════════════════════════════════════════════════════════
;  QBOT — CẤU HÌNH CHUNG CỦA BOT
;
;  File này CHỈ chứa thông số CHUNG, giống nhau cho mọi tài khoản.
;  Thông tin TÀI KHOẢN (API key, secret, Google Sheet, Telegram riêng, %SL/%TP
;  từng lớp…) nằm trên SHEET TỔNG — xem HUONG_DAN_SHEET_TONG.md.
;
;  Chép file này thành config.ini rồi điền 2 dòng bot_id / config_spreadsheet_id.
; ══════════════════════════════════════════════════════════════════════════════
[global]

; ── SHEET TỔNG ────────────────────────────────────────────────────────────────
; bot_id                 tên TAB trên sheet tổng dành cho máy này
;                        (một sheet tổng phục vụ nhiều VPS, mỗi máy 1 tab)
; config_spreadsheet_id  ID của sheet tổng
; config_reload_seconds  bao lâu dò ô phiên bản B1 một lần (giây). Chỉ đọc 1 ô.
;
; Sửa gì trên sheet → ĐỔI Ô B1 → bot xác minh cấu hình mới rồi tự nạp lại.
; Sheet tổng đọc lỗi LÚC KHỞI ĐỘNG → bot DỪNG HẲN, không dùng giá trị dự phòng.
bot_id = QBOT01
config_spreadsheet_id = 1M91d1ShbEeHBdpMCt3dDtS6afCmbYq-x_QPdZ61lroU
config_reload_seconds = 300

; ── TELEGRAM (dùng chung — sheet tổng ghi đè được theo từng tài khoản) ─────────
bot_token = 8431813976:AAHtvnWT3ZTLvtgqlaqYOgyQW-l0bVBwqbI
chat_id = -4654774917
; Bật listener nhận lệnh từ xa (/stop, /long, /short…). Chỉ 1 máy nên bật.
run_tele_command = false

; ── TAB ĐẶT LỆNH trên sheet của từng tài khoản ────────────────────────────────
;   A = Mã   B = Đòn bẩy   D = Giá vào   F = Kiểu lệnh (1-5)   G = Phụ   H = Vốn
;   B2 = trạng thái LONG/SHORT/CHỜ/STOP…   D1:E2 = cấu hình vốn
;   J1:M2 = SỐ DƯ (bot ghi — đừng gõ tay vào đây)
tab_dat_lenh = ĐẶT LỆNH

; ── NHỊP CHẠY (giây, số nguyên dương) ─────────────────────────────────────────
delay_vao_lenh = 60                          ; hd_order_multi — đặt lệnh + SL/TP
delay_cho_va_khop = 600                      ; hd_update_cho_va_khop — nguồn cấp SL/TP
delay_update_all = 120                       ; hd_update_all — số dư J1:M2
delay_calert_possition_and_open_order = 120  ; hd_alert — cảnh báo Telegram

; ── BOT HUỶ LỆNH TREO (hd_cancel_orders_schedule) ─────────────────────────────
cancel_orders_minutes = 60        ; bao lâu quét 1 lần (PHÚT)
cancel_order_after_minutes = 30   ; chỉ huỷ LỆNH VÀO treo quá ngần này phút
; false (AN TOÀN): KHÔNG BAO GIỜ huỷ SL/TP.  true: huỷ tất — vị thế mất bảo vệ!
cancel_all_orders = false

; ── BOT XOÁ LỆNH THEO TICK J–M (hd_cancel_selective) ──────────────────────────
cancel_selective_seconds = 60     ; bao lâu đọc tick 1 lần (GIÂY, tối thiểu 15)

; ── CHỐNG LỖI 429 (Google chỉ cho 60 lượt đọc/phút, dùng CHUNG mọi tài khoản) ──
state_cache_ttl_sec = 10          ; ô B2 chỉ đọc thật mỗi ngần này giây
account_start_stagger_sec = 20    ; các tài khoản khởi động lệch nhau ngần này giây

; ── SỐ DƯ (hd_update_all) ─────────────────────────────────────────────────────
; Ghi số dư vào tab ĐẶT LỆNH, 2 dòng × 4 cột bắt đầu từ cột này (J → J1:M2).
balance_cell = J

; ── GỢI Ý SL/TP (hd_update_cho_va_khop điền vào tab "Chờ và khớp") ──────────────
; Bot điền GIÁ gợi ý vào cột N (cắt lỗ) / O (chốt lời) và cờ P (cho phép) — CHỈ
; điền ô đang trống, không đè số người dùng đã sửa.
; % tính từ giá vào. Mỗi tài khoản đặt riêng được bằng cột %SL / %TP trên sheet
; tổng; hai dòng dưới là mặc định khi sheet để trống.
fill_default_cho_va_khop = true
default_sl_rate_layer_1 = 2
default_tp_rate_layer_1 = 3
; N: bot điền giá, người dùng tự gõ Y vào cột P thì lệnh ngược mới vào.
; Y: SL/TP vào tự động.
default_allow_order = N

; ── BOT ĐẶT LỆNH (hd_order_multi) ─────────────────────────────────────────────
; false: 1 mã chỉ vào 1 lần.  true: cho rải thêm lệnh dù đã có vị thế.
;   ⚠️ Mỗi lệnh vào dùng TRỌN vốn cột H — rải 3 lệnh = 3× vốn.
allow_dca = false
; true: cắt lỗ dùng closePosition → vị thế tăng dần vẫn được bảo vệ đủ.
exit_sl_close_position = true
; true: chốt lời được đặt lại khi khối lượng vị thế đổi.
exit_tp_resize = true
exit_resize_tolerance_pct = 1.0    ; lệch quá ngần này % mới đặt lại
dedup_price_tolerance_pct = 0.02   ; hai lệnh chênh dưới ngần này % mới coi là trùng

; Mỗi "leg" là 1 lệnh con: leg1 = VÀO, leg2 = CẮT LỖ, leg3 = CHỐT LỜI
;   role: entry | exit     source: dat_lenh | cho_va_khop
;   type: limit | market | stop_market | stop_limit | trailing
;   type_col: cột chứa MÃ KIỂU (1-5) để đổi kiểu theo từng dòng
;   col: cột giá      aux: cột phụ (giá limit của stop_limit / callback% của trailing)
multi_leg_count = 3

leg1_role = entry
leg1_source = dat_lenh
leg1_type_col = F
leg1_col = D
leg1_aux = G

leg2_role = exit
leg2_source = cho_va_khop
leg2_type = stop_market
leg2_col = N

leg3_role = exit
leg3_source = cho_va_khop
leg3_type = limit
leg3_col = O
